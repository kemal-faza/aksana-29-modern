{
	"name": "aksana-29-modern",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -n fe,be -c green,cyan 'pnpm dev:fe' 'pnpm dev:be'",
		"dev:fe": "pnpm --filter @aksana/frontend run dev",
		"dev:be": "pnpm --filter @aksana/backend run dev",
		"build:fe": "pnpm --filter @aksana/frontend run dev",
		"build:be": "pnpm --filter @aksana/backend run dev",
		"lint": "pnpm -r run lint"
	},
	"devDependencies": {
		"concurrently": "^9.0.0"
	}
}
